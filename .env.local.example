# ---- ספק ה-AI לחילוץ מילים ----
# אפשרות 1 (מועדף, חינם): OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...
# מודל חינמי (אפשר לשנות). דוגמאות: meta-llama/llama-3.3-70b-instruct:free ,
# google/gemini-2.0-flash-exp:free , deepseek/deepseek-chat-v3-0324:free
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# אפשרות 2 (אם אין OpenRouter): OpenAI
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# ---- אחסון ----
# ברירת מחדל: קובץ מקומי. לענן (Turso) שנו ל libsql://...
# DATABASE_URL=libsql://...
# DATABASE_AUTH_TOKEN=...
# (האינטגרציה של Turso ב-Vercel מזריקה TURSO_DATABASE_URL ו-TURSO_AUTH_TOKEN
#  אוטומטית — הקוד תומך בשניהם.)
